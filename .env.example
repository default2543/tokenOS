AZURE_OPENAI_ENDPOINT=https://tokenos-openai-service.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=tokenos-gpt-54-mini
AZURE_OPENAI_AUTH=api_key
AZURE_OPENAI_API_KEY=

# Required for the hard spend guard. Use the rates for your Azure region.
AZURE_OPENAI_INPUT_USD_PER_MTOK=
AZURE_OPENAI_CACHED_INPUT_USD_PER_MTOK=
AZURE_OPENAI_OUTPUT_USD_PER_MTOK=


# Optional: an open model behind an OpenAI-compatible chat endpoint instead of
# Azure OpenAI. Set AZURE_OPENAI_ENDPOINT to the provider's /v1 URL (e.g.
# https://RESOURCE.services.ai.azure.com/openai/v1 for a Foundry serverless
# deployment, or https://openrouter.ai/api/v1), AZURE_OPENAI_DEPLOYMENT to its
# model name, and the three prices to that model's rates.
# TOKENOS_PROVIDER_API=chat
# TOKENOS_MODEL_NAME=qwen3-coder-30b-a3b
# TOKENOS_MODEL_VERSION=
